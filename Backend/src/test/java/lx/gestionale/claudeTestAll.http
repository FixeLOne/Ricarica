### =====================================================================
### SEZIONE 7 — FATTURE: SETUP BOZZE
### =====================================================================

### 7.1 Admin A crea fattura BOZZA corretta su boutiqueA1 -> ATTESO: 201
POST {{base}}/fatture
Authorization: Bearer {{tokenAdminA}}
Content-Type: application/json

{
  "tipo": "FACTURE",
  "dataEmissione": "2026-05-14",
  "nomeCliente": "Cliente Alfa",
  "timbreFiscal": false,
  "remiseGlobale": 0,
  "boutiqueId": {{boutiqueA1_id}},
  "righe": [
    {"descrizione":"Servizio Ricariche Maggio","quantita":10,"prezzoUnitarioHT":5.000,"aliquotaTVA":19}
  ]
}

> {%
    client.global.set("fatturaA_bozza_id", response.body.id);
%}

###

### 7.2 Admin A crea seconda fattura BOZZA (servirà per test sconto negativo) -> ATTESO: 201
POST {{base}}/fatture
Authorization: Bearer {{tokenAdminA}}
Content-Type: application/json

{
  "tipo": "FACTURE",
  "dataEmissione": "2026-05-14",
  "nomeCliente": "Cliente Beta",
  "timbreFiscal": true,
  "remiseGlobale": 0,
  "boutiqueId": {{boutiqueA1_id}},
  "righe": [
    {"descrizione":"Prodotto A","quantita":2,"prezzoUnitarioHT":20.000,"aliquotaTVA":7},
    {"descrizione":"Prodotto B","quantita":1,"prezzoUnitarioHT":15.000,"aliquotaTVA":7}
  ]
}

> {%
    client.global.set("fatturaA_bozza2_id", response.body.id);
%}

###

### 7.3 Dipendente A1 crea fattura (boutique dal token) -> ATTESO: 201
POST {{base}}/fatture
Authorization: Bearer {{tokenDipA1}}
Content-Type: application/json

{
  "tipo": "BON_DE_LIVRAISON",
  "dataEmissione": "2026-05-14",
  "nomeCliente": "Cliente Gamma",
  "timbreFiscal": false,
  "remiseGlobale": 0,
  "righe": [
    {"descrizione":"Consegna Merce","quantita":1,"prezzoUnitarioHT":30.000,"aliquotaTVA":0}
  ]
}

> {%
    client.global.set("fatturaDip_bozza_id", response.body.id);
%}

###

### 7.4 SuperAdmin crea fattura (nessun boutiqueId — solo admin) -> ATTESO: 201
POST {{base}}/fatture
Authorization: Bearer {{tokenSuper}}
Content-Type: application/json

{
  "tipo": "DEVIS",
  "dataEmissione": "2026-05-14",
  "nomeCliente": "Cliente Super",
  "timbreFiscal": false,
  "remiseGlobale": 0,
  "righe": [
    {"descrizione":"Preventivo Annuale","quantita":1,"prezzoUnitarioHT":100.000,"aliquotaTVA":19}
  ]
}

> {%
    client.global.set("fatturaSuper_bozza_id", response.body.id);
%}

###


### =====================================================================
### SEZIONE 8 — FATTURE: VALIDAZIONI E CRASH BAIT CREAZIONE
### =====================================================================

### 8.1 [VALIDATION] Nessun tipo documento -> ATTESO: 400
POST {{base}}/fatture
Authorization: Bearer {{tokenAdminA}}
Content-Type: application/json

{
  "dataEmissione": "2026-05-14",
  "nomeCliente": "Senza Tipo",
  "remiseGlobale": 0,
  "boutiqueId": {{boutiqueA1_id}},
  "righe": [{"descrizione":"Test","quantita":1,"prezzoUnitarioHT":10,"aliquotaTVA":19}]
}

###

### 8.2 [CRASH BAIT] Tipo documento come stringa non valida -> ATTESO: 400 (non 500)
POST {{base}}/fatture
Authorization: Bearer {{tokenAdminA}}
Content-Type: application/json

{
  "tipo": "RICEVUTA_FISCALE",
  "dataEmissione": "2026-05-14",
  "nomeCliente": "Tipo Sbagliato",
  "remiseGlobale": 0,
  "boutiqueId": {{boutiqueA1_id}},
  "righe": [{"descrizione":"Test","quantita":1,"prezzoUnitarioHT":10,"aliquotaTVA":19}]
}

